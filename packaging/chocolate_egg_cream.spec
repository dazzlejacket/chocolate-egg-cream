# -*- mode: python ; coding: utf-8 -*-
"""Cross-platform PyInstaller spec for Chocolate Egg Cream.

Builds:
  - Windows: standalone single-file windowed EXE (no console window, purple egg icon)
  - macOS:   Chocolate Egg Cream.app bundle with embedded SystemAudioCapture helper,
             purple egg .icns, and NSAudioCaptureUsageDescription (audio-only)
  - Linux:   self-contained onedir bundle (packaged into AppImage / tar.gz)
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

from PyInstaller.utils.hooks import collect_data_files, collect_dynamic_libs, collect_submodules

ROOT = Path(SPECPATH).resolve().parent
APP_NAME = "Chocolate Egg Cream"
BUNDLE_ID = "com.chocolateeggcream.app"

# Read version without importing heavy runtime deps.
VERSION = "1.1.0"
init_file = ROOT / "chocolate_egg_cream" / "__init__.py"
for line in init_file.read_text(encoding="utf-8").splitlines():
    if line.startswith("__version__"):
        VERSION = line.split("=", 1)[1].strip().strip('"').strip("'")
        break

datas = []
binaries = []
hiddenimports = [
    "chocolate_egg_cream",
    "chocolate_egg_cream.certs",
    "chocolate_egg_cream.capture",
    "chocolate_egg_cream.history",
    "chocolate_egg_cream.instance",
    "chocolate_egg_cream.scrobble",
    "chocolate_egg_cream.scrobble.external",
    "chocolate_egg_cream.scrobble.lastfm",
    "chocolate_egg_cream.scrobble.lastfm_app",
    "chocolate_egg_cream.scrobble.listenbrainz",
    "chocolate_egg_cream.theme",
    "chocolate_egg_cream.verify",
    "tkinter",
    "tkinter.filedialog",
    "tkinter.ttk",
]

# Include build-time injected Last.fm app credentials if generated by build script.
if (ROOT / "chocolate_egg_cream" / "_bundled_lastfm.py").is_file():
    hiddenimports.append("chocolate_egg_cream._bundled_lastfm")

# Bundle tiny runtime window/header icon assets (platform-minimal).
assets_dir = ROOT / "chocolate_egg_cream" / "assets"
for fname in ("icon-32.png", "icon-64.png"):
    fpath = assets_dir / fname
    if fpath.is_file():
        datas.append((str(fpath), "chocolate_egg_cream/assets"))
if sys.platform == "win32":
    ico_asset = assets_dir / "chocolate-egg-cream.ico"
    if ico_asset.is_file():
        datas.append((str(ico_asset), "chocolate_egg_cream/assets"))

# Bundle shazamio + shazamio_core (native Rust extension) + certifi CA certs.
# The CA bundle is what makes TLS verification work inside the bundle: without
# it aiohttp/ssl has no trust anchors on macOS and Linux (CERTIFICATE_VERIFY
# FAILED against Shazam). Verification itself is never disabled.
datas += collect_data_files("certifi")
cacert_bundles = [
    src
    for src, dest, *_ in datas
    if os.path.basename(src) == "cacert.pem"
]
if not cacert_bundles:
    raise SystemExit(
        "certifi's cacert.pem was not collected: packaged builds would fail "
        "TLS verification. Refusing to build a broken artifact."
    )
datas += collect_data_files("shazamio")
binaries += collect_dynamic_libs("shazamio_core")
hiddenimports += collect_submodules("shazamio")
hiddenimports += collect_submodules("shazamio_core")

if sys.platform != "darwin":
    # soundcard loads C headers (.py.h) at runtime via cffi.
    datas += collect_data_files("soundcard")
    hiddenimports += ["soundcard", "_cffi_backend"]
    if sys.platform == "win32":
        hiddenimports.append("chocolate_egg_cream.capture.windows")
    elif sys.platform.startswith("linux"):
        hiddenimports.append("chocolate_egg_cream.capture.linux")
else:
    hiddenimports.append("chocolate_egg_cream.capture.macos")
    # Bundle pre-compiled macOS SystemAudioCapture Swift helper into Contents/MacOS/.
    helper_bin = ROOT / "tools" / "SystemAudioCapture"
    if not helper_bin.is_file():
        raise FileNotFoundError(
            f"Compiled macOS audio helper not found at {helper_bin}. "
            "Run scripts/build_macos.sh or compile tools/SystemAudioCapture.swift first."
        )
    binaries.append((str(helper_bin), "."))

# Trim unused stdlib, build-tool, and test modules to keep the bundle lean.
excludes = [
    "matplotlib",
    "PIL",
    "IPython",
    "jupyter",
    "notebook",
    "pytest",
    "tkinter.test",
    "tkinter.tix",
    "test",
    "unittest",
    "doctest",
    "pydoc",
    "pydoc_data",
    "pdb",
    "_pyrepl",
    "lib2to3",
    "setuptools",
    "pkg_resources",
    "packaging",
    "scipy",
    "pyloudnorm",
    "numpy.testing",
    "numpy.f2py",
    "numpy.distutils",
]

a = Analysis(
    [str(ROOT / "packaging" / "entrypoint.py")],
    pathex=[str(ROOT)],
    binaries=binaries,
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    # Runs before the app's own code so ssl/aiohttp/requests all trust the
    # bundled cacert.pem from the first connection.
    runtime_hooks=[str(ROOT / "packaging" / "runtime_hook.py")],
    excludes=excludes,
    noarchive=False,
)

# On Linux, never bundle host audio libraries so the AppImage/bundle uses the
# user's native PipeWire or PulseAudio client library.
if sys.platform.startswith("linux"):
    skip_prefixes = ("libpulse", "libasound", "libpipewire", "libjack", "libsndfile")
    a.binaries = [
        b for b in a.binaries
        if not os.path.basename(b[0]).startswith(skip_prefixes)
    ]

pyz = PYZ(a.pure)

WIN_ICON = ROOT / "packaging" / "icons" / "chocolate-egg-cream.ico"
MAC_ICON = ROOT / "packaging" / "icons" / "chocolate-egg-cream.icns"

if sys.platform == "win32":
    exe = EXE(
        pyz,
        a.scripts,
        a.binaries,
        a.datas,
        [],
        name=APP_NAME,
        icon=str(WIN_ICON) if WIN_ICON.is_file() else None,
        debug=False,
        bootloader_ignore_signals=False,
        strip=False,
        upx=False,
        upx_exclude=[],
        runtime_tmpdir=None,
        console=False,
        disable_windowed_traceback=False,
    )
elif sys.platform == "darwin":
    exe = EXE(
        pyz,
        a.scripts,
        [],
        exclude_binaries=True,
        name=APP_NAME,
        debug=False,
        bootloader_ignore_signals=False,
        strip=False,
        upx=False,
        console=False,
        disable_windowed_traceback=False,
        argv_emulation=False,
    )
    coll = COLLECT(
        exe,
        a.binaries,
        a.datas,
        strip=False,
        upx=False,
        name=APP_NAME,
    )
    app = BUNDLE(
        coll,
        name=f"{APP_NAME}.app",
        icon=str(MAC_ICON) if MAC_ICON.is_file() else None,
        bundle_identifier=BUNDLE_ID,
        version=VERSION,
        info_plist={
            "CFBundleName": APP_NAME,
            "CFBundleDisplayName": APP_NAME,
            "CFBundleIdentifier": BUNDLE_ID,
            "CFBundleShortVersionString": VERSION,
            "CFBundleVersion": VERSION,
            "LSMinimumSystemVersion": "13.0",
            "NSHighResolutionCapable": True,
            "LSApplicationCategoryType": "public.app-category.music",
            # Core Audio Taps (macOS 14.2+) audio-only system capture permission.
            # Explicitly no NSMicrophoneUsageDescription or NSCameraUsageDescription.
            "NSAudioCaptureUsageDescription": (
                "Chocolate Egg Cream captures system audio to identify playing "
                "songs and scrobble them. It never captures your screen or microphone."
            ),
        },
    )
else:
    exe = EXE(
        pyz,
        a.scripts,
        [],
        exclude_binaries=True,
        name="chocolate-egg-cream",
        debug=False,
        bootloader_ignore_signals=False,
        strip=False,
        upx=False,
        console=False,
    )
    coll = COLLECT(
        exe,
        a.binaries,
        a.datas,
        strip=False,
        upx=False,
        name="chocolate-egg-cream",
    )
